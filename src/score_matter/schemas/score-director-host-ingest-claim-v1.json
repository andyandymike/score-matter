{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-director-host-ingest-claim-v1.json",
  "title": "ScoreMatter Director Host Ingest Claim v1",
  "description": "An out-of-evidence-root, no-replace claim that fixes one accepted host submission for one exact request before parsing or adjudication.",
  "type": "object",
  "required": [
    "schema",
    "claim_id",
    "request_sha256",
    "raw_submission_sha256",
    "adjudication_sha256",
    "evidence_root",
    "state",
    "claimed_at"
  ],
  "properties": {
    "schema": { "const": "score-director-host-ingest-claim/v1" },
    "claim_id": { "$ref": "#/$defs/id" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "raw_submission_sha256": { "$ref": "#/$defs/sha256" },
    "adjudication_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "evidence_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "state": { "const": "claimed" },
    "claimed_at": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  }
}
