{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-director-trace-v1.json",
  "title": "ScoreMatter Director Trace v1",
  "type": "object",
  "required": [
    "schema",
    "trace_id",
    "run_id",
    "spec_sha256",
    "evaluation_plan_sha256",
    "phase_authorization_sha256",
    "context_sha256",
    "adjudication_sha256",
    "request_sha256",
    "raw_response_sha256",
    "agent_response_sha256",
    "gap_report_sha256",
    "direction_set_sha256",
    "brief_draft_sha256",
    "plan_draft_sha256",
    "agent",
    "allowed_tools",
    "observed_tool_calls",
    "usage",
    "stub_counters",
    "validation",
    "terminal_state",
    "started_at",
    "ended_at"
  ],
  "properties": {
    "schema": { "const": "score-director-trace/v1" },
    "trace_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "spec_sha256": { "$ref": "#/$defs/sha256" },
    "evaluation_plan_sha256": { "$ref": "#/$defs/sha256" },
    "phase_authorization_sha256": { "$ref": "#/$defs/sha256" },
    "context_sha256": { "$ref": "#/$defs/sha256" },
    "adjudication_sha256": { "$ref": "#/$defs/sha256" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "raw_response_sha256": { "$ref": "#/$defs/sha256" },
    "agent_response_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "gap_report_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "direction_set_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "brief_draft_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "plan_draft_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "agent": {
      "type": "object",
      "required": [
        "backend_id",
        "model_id",
        "model_revision",
        "component_sha256",
        "kernel_sha256",
        "policy_sha256",
        "settings",
        "settings_sha256"
      ],
      "properties": {
        "backend_id": { "$ref": "#/$defs/id" },
        "model_id": { "$ref": "#/$defs/id" },
        "model_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "component_sha256": { "$ref": "#/$defs/sha256" },
        "kernel_sha256": { "$ref": "#/$defs/sha256" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "settings": { "$ref": "#/$defs/settings" },
        "settings_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "allowed_tools": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "observed_tool_calls": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "tool_call_id",
          "tool_id",
          "input_sha256",
          "output_sha256",
          "status"
        ],
        "properties": {
          "tool_call_id": { "$ref": "#/$defs/id" },
          "tool_id": { "$ref": "#/$defs/id" },
          "input_sha256": { "$ref": "#/$defs/sha256" },
          "output_sha256": { "$ref": "#/$defs/nullable_sha256" },
          "status": { "enum": ["completed", "blocked", "failed"] }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "external_cost_usd",
        "elapsed_ms"
      ],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "total_tokens": { "type": "integer", "minimum": 0, "maximum": 20000000 },
        "external_cost_usd": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      },
      "additionalProperties": false
    },
    "stub_counters": { "$ref": "#/$defs/stub_counters" },
    "validation": {
      "type": "object",
      "required": ["json_valid", "schema_valid", "semantic_valid", "errors"],
      "properties": {
        "json_valid": { "type": "boolean" },
        "schema_valid": { "type": "boolean" },
        "semantic_valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["code", "path", "message"],
            "properties": {
              "code": { "$ref": "#/$defs/id" },
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "message": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "terminal_state": {
      "enum": [
        "ready",
        "clarification_required",
        "abstain",
        "safety_rejected",
        "malformed_response",
        "model_refusal",
        "timeout",
        "validator_rejected",
        "authority_escalation",
        "aborted"
      ]
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "settings": {
      "type": "object",
      "required": ["temperature", "top_p", "max_output_tokens", "seed", "response_format"],
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "seed": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          ]
        },
        "response_format": { "const": "json" }
      },
      "additionalProperties": false
    },
    "stub_counters": {
      "type": "object",
      "required": ["generator_calls", "critic_calls", "reference_audio_calls"],
      "properties": {
        "generator_calls": { "type": "integer", "minimum": 0, "maximum": 128 },
        "critic_calls": { "type": "integer", "minimum": 0, "maximum": 128 },
        "reference_audio_calls": { "type": "integer", "minimum": 0, "maximum": 128 }
      },
      "additionalProperties": false
    }
  }
}
