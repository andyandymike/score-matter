{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-provider-descriptor-v1.json",
  "title": "ScoreMatter Provider Descriptor v1",
  "type": "object",
  "required": [
    "schema",
    "provider_id",
    "adapter_version",
    "execution_mode",
    "protocol_version",
    "components",
    "capabilities",
    "limits"
  ],
  "properties": {
    "schema": { "const": "score-provider-descriptor/v1" },
    "provider_id": { "$ref": "#/$defs/id" },
    "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][a-z0-9.]+)?$" },
    "execution_mode": { "enum": ["manual", "mock", "replay", "local", "api"] },
    "protocol_version": { "const": "score-provider-protocol/v1" },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "kind",
          "locator",
          "revision",
          "sha256",
          "license_snapshot_id"
        ],
        "properties": {
          "component_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["adapter", "generator", "codec", "conditioner", "postprocessor"] },
          "locator": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "license_snapshot_id": { "$ref": "#/$defs/id" }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["capability_id", "state", "constraints", "evidence"],
        "properties": {
          "capability_id": { "$ref": "#/$defs/id" },
          "state": { "enum": ["unsupported", "claimed", "experimental", "verified"] },
          "constraints": { "type": "object" },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_input_bytes", "max_duration_samples", "formats"],
      "properties": {
        "max_input_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "max_duration_samples": { "type": "integer", "minimum": 1, "maximum": 230400000 },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "enum": ["wav_pcm_s16le"] }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
