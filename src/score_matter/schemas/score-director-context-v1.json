{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-director-context-v1.json",
  "title": "ScoreMatter Director Context v1",
  "type": "object",
  "required": [
    "schema",
    "context_id",
    "spec_sha256",
    "scenario_id",
    "project_id",
    "cue_id",
    "intended_use",
    "provider_descriptor_sha256",
    "source_documents",
    "natural_language_request",
    "material_inputs",
    "consumer_exports"
  ],
  "properties": {
    "schema": { "const": "score-director-context/v1" },
    "context_id": { "$ref": "#/$defs/id" },
    "spec_sha256": { "$ref": "#/$defs/sha256" },
    "scenario_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "cue_id": { "$ref": "#/$defs/id" },
    "intended_use": {
      "enum": ["local_preview", "internal_eval", "game_asset_candidate"]
    },
    "provider_descriptor_sha256": { "$ref": "#/$defs/sha256" },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["source_id", "sha256", "role"],
        "properties": {
          "source_id": { "$ref": "#/$defs/id" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "role": {
            "enum": [
              "human_request",
              "project_context",
              "consumer_export",
              "clarification_answer",
              "provider_descriptor"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "natural_language_request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "material_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["input_id", "field_path", "presence", "value", "source_ids"],
        "properties": {
          "input_id": { "$ref": "#/$defs/id" },
          "field_path": { "$ref": "#/$defs/field_path" },
          "presence": { "enum": ["supplied", "missing"] },
          "value": {},
          "source_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        },
        "additionalProperties": false
      }
    },
    "consumer_exports": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["export_id", "sha256", "consumer_id", "purpose"],
        "properties": {
          "export_id": { "$ref": "#/$defs/id" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "consumer_id": { "$ref": "#/$defs/id" },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "field_path": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,15}$",
      "maxLength": 256
    }
  }
}
