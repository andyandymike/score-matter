{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-direction-set-v1.json",
  "title": "ScoreMatter Direction Set v1",
  "type": "object",
  "required": [
    "schema",
    "direction_set_id",
    "context_sha256",
    "agent_response_sha256",
    "gap_report_sha256",
    "shared_invariants",
    "directions",
    "recommended_direction_id",
    "recommendation_authority",
    "recommendation_basis"
  ],
  "properties": {
    "schema": { "const": "score-direction-set/v1" },
    "direction_set_id": { "$ref": "#/$defs/id" },
    "context_sha256": { "$ref": "#/$defs/sha256" },
    "agent_response_sha256": { "$ref": "#/$defs/sha256" },
    "gap_report_sha256": { "$ref": "#/$defs/sha256" },
    "shared_invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["invariant_id", "statement", "enforcement"],
        "properties": {
          "invariant_id": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "enforcement": { "enum": ["required", "preferred"] }
        },
        "additionalProperties": false
      }
    },
    "directions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/direction" }
    },
    "recommended_direction_id": { "$ref": "#/$defs/id" },
    "recommendation_authority": {
      "const": "agent_recommendation_for_fixture"
    },
    "recommendation_basis": { "type": "string", "minLength": 1, "maxLength": 2048 }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "field_path": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,15}$",
      "maxLength": 256
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "axes": {
      "type": "object",
      "required": [
        "palette",
        "register",
        "density",
        "articulation",
        "harmony",
        "rhythm",
        "energy",
        "foreground_occupancy",
        "entry_exit",
        "loop_behaviour"
      ],
      "properties": {
        "palette": { "$ref": "#/$defs/text" },
        "register": { "$ref": "#/$defs/text" },
        "density": { "$ref": "#/$defs/text" },
        "articulation": { "$ref": "#/$defs/text" },
        "harmony": { "$ref": "#/$defs/text" },
        "rhythm": { "$ref": "#/$defs/text" },
        "energy": { "$ref": "#/$defs/text" },
        "foreground_occupancy": { "enum": ["low", "medium", "high"] },
        "entry_exit": { "$ref": "#/$defs/text" },
        "loop_behaviour": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "capability_risk": {
      "type": "object",
      "required": ["capability_id", "risk", "required"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/id" },
        "risk": { "$ref": "#/$defs/text" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "direction": {
      "type": "object",
      "required": [
        "direction_id",
        "title",
        "gameplay_hypothesis",
        "emotional_targets",
        "anti_targets",
        "axes",
        "dialogue_sfx_occupancy",
        "neighbour_cue_behaviour",
        "expected_audible_evidence",
        "likely_failure_modes",
        "required_fields",
        "preferred_fields",
        "provider_capability_risks",
        "difference_summary"
      ],
      "properties": {
        "direction_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "gameplay_hypothesis": { "$ref": "#/$defs/text" },
        "emotional_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "anti_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "axes": { "$ref": "#/$defs/axes" },
        "dialogue_sfx_occupancy": { "enum": ["low", "medium", "high"] },
        "neighbour_cue_behaviour": { "$ref": "#/$defs/text" },
        "expected_audible_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/text" }
        },
        "likely_failure_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/text" }
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/field_path" }
        },
        "preferred_fields": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/field_path" }
        },
        "provider_capability_risks": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/capability_risk" }
        },
        "difference_summary": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    }
  }
}
