{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-director-host-ingest-receipt-v1.json",
  "title": "ScoreMatter Director Host Ingest Receipt v1",
  "type": "object",
  "required": [
    "schema",
    "ingest_id",
    "run_id",
    "request_sha256",
    "ingest_claim_sha256",
    "raw_submission_sha256",
    "retained_raw_submission_sha256",
    "raw_response_sha256",
    "retained_raw_response_sha256",
    "context_sha256",
    "provider_descriptor_sha256",
    "adjudication_sha256",
    "agent_response_sha256",
    "gap_report_sha256",
    "direction_set_sha256",
    "brief_draft_sha256",
    "plan_draft_sha256",
    "host_disclosure",
    "usage",
    "adjudication_result",
    "validation",
    "assurance",
    "conclusion",
    "reported_at"
  ],
  "properties": {
    "schema": { "const": "score-director-host-ingest-receipt/v1" },
    "ingest_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "ingest_claim_sha256": { "$ref": "#/$defs/sha256" },
    "raw_submission_sha256": { "$ref": "#/$defs/sha256" },
    "retained_raw_submission_sha256": { "$ref": "#/$defs/sha256" },
    "raw_response_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "retained_raw_response_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "context_sha256": { "$ref": "#/$defs/sha256" },
    "provider_descriptor_sha256": { "$ref": "#/$defs/sha256" },
    "adjudication_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "agent_response_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "gap_report_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "direction_set_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "brief_draft_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "plan_draft_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "host_disclosure": {
      "type": "object",
      "required": [
        "identity_observation",
        "settings_observation",
        "usage_observation",
        "tool_observation"
      ],
      "properties": {
        "identity_observation": { "$ref": "#/$defs/observation" },
        "settings_observation": { "const": "unavailable" },
        "usage_observation": { "$ref": "#/$defs/observation" },
        "tool_observation": { "$ref": "#/$defs/observation" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "external_cost_usd", "elapsed_ms"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/nullable_nonnegative_integer" },
        "output_tokens": { "$ref": "#/$defs/nullable_nonnegative_integer" },
        "external_cost_usd": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0, "maximum": 1000000 }
          ]
        },
        "elapsed_ms": { "$ref": "#/$defs/nullable_nonnegative_integer" }
      },
      "additionalProperties": false
    },
    "adjudication_result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "critical_hallucinations",
            "authority_escalations",
            "forbidden_claims",
            "validation",
            "metrics"
          ],
          "properties": {
            "critical_hallucinations": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/$defs/finding" }
            },
            "authority_escalations": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/$defs/finding" }
            },
            "forbidden_claims": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/$defs/finding" }
            },
            "validation": {
              "type": "object",
              "required": [
                "context_hash_matched",
                "schema_valid",
                "semantic_valid",
                "expected_stop_matched",
                "required_constraints_preserved",
                "route_state_matched",
                "direction_diversity_verified"
              ],
              "properties": {
                "context_hash_matched": { "type": "boolean" },
                "schema_valid": { "type": "boolean" },
                "semantic_valid": { "type": "boolean" },
                "expected_stop_matched": { "type": "boolean" },
                "required_constraints_preserved": { "$ref": "#/$defs/nullable_boolean" },
                "route_state_matched": { "$ref": "#/$defs/nullable_boolean" },
                "direction_diversity_verified": { "$ref": "#/$defs/nullable_boolean" }
              },
              "additionalProperties": false
            },
            "metrics": {
              "type": "object",
              "required": [
                "missing_field_recall",
                "missing_field_precision",
                "direction_axis_difference_count",
                "brief_plan_complete",
                "route_correct",
                "stop_correct"
              ],
              "properties": {
                "missing_field_recall": { "$ref": "#/$defs/nullable_ratio" },
                "missing_field_precision": { "$ref": "#/$defs/nullable_ratio" },
                "direction_axis_difference_count": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "integer", "minimum": 0, "maximum": 10 }
                  ]
                },
                "brief_plan_complete": { "type": "boolean" },
                "route_correct": { "$ref": "#/$defs/nullable_boolean" },
                "stop_correct": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "submission_json_valid",
        "submission_schema_valid",
        "request_binding_matched",
        "response_json_valid",
        "response_schema_valid",
        "semantic_valid",
        "errors"
      ],
      "properties": {
        "submission_json_valid": { "type": "boolean" },
        "submission_schema_valid": { "type": "boolean" },
        "request_binding_matched": { "type": "boolean" },
        "response_json_valid": { "type": "boolean" },
        "response_schema_valid": { "type": "boolean" },
        "semantic_valid": { "$ref": "#/$defs/nullable_boolean" },
        "errors": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["code", "path", "message"],
            "properties": {
              "code": { "$ref": "#/$defs/id" },
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "message": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "assurance": {
      "type": "object",
      "required": [
        "mode",
        "kernel_model_calls",
        "complete_model_visible_context_verified",
        "model_identity_verified",
        "model_settings_verified",
        "token_usage_verified",
        "cost_verified",
        "tool_call_completeness_verified",
        "hidden_adjudication_isolation_verified",
        "single_inference_verified",
        "capability_pass_eligible"
      ],
      "properties": {
        "mode": { "const": "host_agent_response_ingest" },
        "kernel_model_calls": { "const": 0 },
        "complete_model_visible_context_verified": { "const": false },
        "model_identity_verified": { "const": false },
        "model_settings_verified": { "const": false },
        "token_usage_verified": { "const": false },
        "cost_verified": { "const": false },
        "tool_call_completeness_verified": { "const": false },
        "hidden_adjudication_isolation_verified": { "const": false },
        "single_inference_verified": { "const": false },
        "capability_pass_eligible": { "const": false }
      },
      "additionalProperties": false
    },
    "conclusion": {
      "enum": [
        "diagnostic_contract_validated",
        "diagnostic_adjudication_matched",
        "diagnostic_adjudication_failed",
        "submission_rejected"
      ]
    },
    "reported_at": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "nullable_boolean": {
      "oneOf": [{ "type": "null" }, { "type": "boolean" }]
    },
    "nullable_ratio": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ]
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "evidence", "rationale"],
      "properties": {
        "finding_id": { "$ref": "#/$defs/id" },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2048 }
      },
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "observation": {
      "enum": ["host_reported", "operator_declared", "unavailable"]
    },
    "nullable_nonnegative_integer": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 20000000 }
      ]
    }
  }
}
