{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-director-command-descriptor-v1.json",
  "title": "ScoreMatter Director Command Descriptor v1",
  "type": "object",
  "required": [
    "schema",
    "backend_id",
    "protocol_version",
    "executable",
    "executable_sha256",
    "arguments",
    "environment",
    "working_directory",
    "working_directory_manifest_sha256",
    "model_id",
    "model_revision",
    "model_artifacts",
    "max_output_bytes",
    "isolation"
  ],
  "properties": {
    "schema": { "const": "score-director-command-descriptor/v1" },
    "backend_id": { "const": "local_jsonl_command" },
    "protocol_version": { "const": "score-director-jsonl/v1" },
    "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "executable_sha256": { "$ref": "#/$defs/sha256" },
    "arguments": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "environment": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "value": { "type": "string", "maxLength": 8192 }
        },
        "additionalProperties": false
      }
    },
    "working_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "working_directory_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "model_id": { "$ref": "#/$defs/id" },
    "model_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "model_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "locator",
          "revision",
          "sha256",
          "license_snapshot_id"
        ],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "locator": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "license_snapshot_id": { "$ref": "#/$defs/id" }
        },
        "additionalProperties": false
      }
    },
    "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "isolation": {
      "type": "object",
      "required": [
        "profile",
        "network",
        "filesystem",
        "process_tree",
        "observation_sha256"
      ],
      "properties": {
        "profile": { "const": "process_observed" },
        "network": { "const": "not_verified" },
        "filesystem": { "const": "not_verified" },
        "process_tree": { "const": "not_verified" },
        "observation_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
