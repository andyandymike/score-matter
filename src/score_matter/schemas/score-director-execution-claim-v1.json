{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-director-execution-claim-v1.json",
  "title": "ScoreMatter Director Execution Claim v1",
  "type": "object",
  "required": [
    "schema",
    "claim_id",
    "claim_nonce",
    "evaluation_plan_sha256",
    "phase_authorization_sha256",
    "evidence_root",
    "state",
    "claimed_at"
  ],
  "properties": {
    "schema": { "const": "score-director-execution-claim/v1" },
    "claim_id": { "$ref": "#/$defs/id" },
    "claim_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "evaluation_plan_sha256": { "$ref": "#/$defs/sha256" },
    "phase_authorization_sha256": { "$ref": "#/$defs/sha256" },
    "evidence_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "state": { "const": "claimed" },
    "claimed_at": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  }
}
