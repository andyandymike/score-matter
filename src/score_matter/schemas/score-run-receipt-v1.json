{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-run-receipt-v1.json",
  "title": "ScoreMatter Run Receipt v1",
  "type": "object",
  "required": [
    "schema",
    "execution_id",
    "operation",
    "request_sha256",
    "source_run_receipt_sha256",
    "provider_id",
    "provider_descriptor_sha256",
    "adapter_version",
    "started_at",
    "ended_at",
    "elapsed_ms",
    "requested_seed",
    "effective_seed",
    "environment",
    "isolation",
    "warnings",
    "artifacts",
    "reproducibility",
    "bit_exact_regeneration_guaranteed"
  ],
  "properties": {
    "schema": { "const": "score-run-receipt/v1" },
    "execution_id": { "$ref": "#/$defs/id" },
    "operation": { "enum": ["generate", "ingest", "replay"] },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "source_run_receipt_sha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "provider_id": { "$ref": "#/$defs/id" },
    "provider_descriptor_sha256": { "$ref": "#/$defs/sha256" },
    "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][a-z0-9.]+)?$" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "requested_seed": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      ]
    },
    "effective_seed": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      ]
    },
    "environment": {
      "type": "object",
      "required": ["python", "platform", "machine"],
      "properties": {
        "python": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "machine": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "required": ["profile", "network"],
      "properties": {
        "profile": { "enum": ["process_observed", "os_enforced"] },
        "network": { "enum": ["not_used_by_builtin", "denied", "not_verified"] }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "artifact_sha256",
          "byte_count",
          "store_path",
          "manifest_sha256",
          "manifest_path"
        ],
        "properties": {
          "artifact_sha256": { "$ref": "#/$defs/sha256" },
          "byte_count": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
          "store_path": { "$ref": "#/$defs/path" },
          "manifest_sha256": { "$ref": "#/$defs/sha256" },
          "manifest_path": { "$ref": "#/$defs/path" }
        },
        "additionalProperties": false
      }
    },
    "reproducibility": { "enum": ["exact", "best_effort", "unknown"] },
    "bit_exact_regeneration_guaranteed": { "type": "boolean" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,511}$"
    }
  }
}
