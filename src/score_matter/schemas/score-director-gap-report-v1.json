{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-director-gap-report-v1.json",
  "title": "ScoreMatter Director Gap Report v1",
  "type": "object",
  "required": [
    "schema",
    "gap_report_id",
    "context_sha256",
    "agent_response_sha256",
    "terminal_state",
    "material_input_ids",
    "classifications",
    "questions",
    "clarification_round",
    "stop_reasons"
  ],
  "properties": {
    "schema": { "const": "score-director-gap-report/v1" },
    "gap_report_id": { "$ref": "#/$defs/id" },
    "context_sha256": { "$ref": "#/$defs/sha256" },
    "agent_response_sha256": { "$ref": "#/$defs/sha256" },
    "terminal_state": { "$ref": "#/$defs/terminal_state" },
    "material_input_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/classification" }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/question" }
    },
    "clarification_round": { "type": "integer", "minimum": 0, "maximum": 1 },
    "stop_reasons": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "terminal_state": {
      "enum": ["ready", "clarification_required", "abstain", "safety_rejected"]
    },
    "classification": {
      "type": "object",
      "required": ["material_input_id", "classification", "statement", "rationale"],
      "properties": {
        "material_input_id": { "$ref": "#/$defs/id" },
        "classification": {
          "enum": [
            "explicit_fact",
            "required_constraint",
            "preferred_constraint",
            "assumption_proposed_for_review",
            "unknown_blocking",
            "unknown_non_blocking",
            "conflict"
          ]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2048 }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["question_id", "material_input_ids", "text", "why_material"],
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "material_input_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "why_material": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    }
  }
}
