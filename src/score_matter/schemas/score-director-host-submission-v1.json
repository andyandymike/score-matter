{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-director-host-submission-v1.json",
  "title": "ScoreMatter Director Host Submission v1",
  "description": "An operator-captured, byte-exact bare host-agent response with explicit disclosure limits. All host claims remain unverified input.",
  "type": "object",
  "required": [
    "schema",
    "submission_id",
    "run_id",
    "request_sha256",
    "host_disclosure",
    "usage",
    "observed_tool_calls",
    "response_capture",
    "captured_at"
  ],
  "properties": {
    "schema": { "const": "score-director-host-submission/v1" },
    "submission_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "host_disclosure": {
      "type": "object",
      "required": [
        "host_product",
        "host_version",
        "model_id",
        "model_revision",
        "identity_observation",
        "settings_observation",
        "usage_observation",
        "tool_observation",
        "complete_context_observation",
        "hidden_adjudication_isolation",
        "single_inference"
      ],
      "properties": {
        "host_product": { "$ref": "#/$defs/id" },
        "host_version": { "$ref": "#/$defs/nullable_text" },
        "model_id": { "$ref": "#/$defs/nullable_text" },
        "model_revision": { "$ref": "#/$defs/nullable_text" },
        "identity_observation": { "$ref": "#/$defs/observation" },
        "settings_observation": { "const": "unavailable" },
        "usage_observation": { "$ref": "#/$defs/observation" },
        "tool_observation": { "$ref": "#/$defs/observation" },
        "complete_context_observation": { "const": "unavailable" },
        "hidden_adjudication_isolation": { "const": "not_verified" },
        "single_inference": { "const": "not_verified" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "external_cost_usd",
        "elapsed_ms"
      ],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/nullable_nonnegative_integer" },
        "output_tokens": { "$ref": "#/$defs/nullable_nonnegative_integer" },
        "external_cost_usd": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0, "maximum": 1000000 }
          ]
        },
        "elapsed_ms": { "$ref": "#/$defs/nullable_nonnegative_integer" }
      },
      "additionalProperties": false
    },
    "observed_tool_calls": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "response_capture": {
      "type": "object",
      "required": [
        "encoding",
        "media_type",
        "raw_sha256",
        "raw_byte_count",
        "data_base64"
      ],
      "properties": {
        "encoding": { "const": "base64" },
        "media_type": { "const": "application/json" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "raw_byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 524288
        },
        "data_base64": {
          "type": "string",
          "maxLength": 699052,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "additionalProperties": false
    },
    "captured_at": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "observation": {
      "enum": ["host_reported", "operator_declared", "unavailable"]
    },
    "nullable_text": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 256 }
      ]
    },
    "nullable_nonnegative_integer": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 20000000 }
      ]
    }
  }
}
