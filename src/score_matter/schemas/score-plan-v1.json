{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score-matter.dev/schemas/score-plan-v1.json",
  "title": "ScoreMatter Plan v1",
  "type": "object",
  "required": [
    "schema",
    "plan_id",
    "brief_sha256",
    "package_class",
    "sections",
    "controls",
    "budget",
    "profiles",
    "allowed_postprocess"
  ],
  "properties": {
    "schema": { "const": "score-plan/v1" },
    "plan_id": { "$ref": "#/$defs/id" },
    "brief_sha256": { "$ref": "#/$defs/sha256" },
    "package_class": { "enum": ["evaluation_only"] },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["section_id", "bars", "intent"],
        "properties": {
          "section_id": { "$ref": "#/$defs/id" },
          "bars": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "intent": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["control_id", "value", "enforcement"],
        "properties": {
          "control_id": { "$ref": "#/$defs/id" },
          "value": {},
          "enforcement": { "enum": ["required", "preferred"] }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": ["candidate_count", "max_attempts", "max_runtime_seconds"],
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_runtime_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "required": ["qa_profile_id", "evaluation_profile_id"],
      "properties": {
        "qa_profile_id": { "$ref": "#/$defs/id" },
        "evaluation_profile_id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "allowed_postprocess": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
